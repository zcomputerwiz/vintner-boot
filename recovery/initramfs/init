#!/bin/busybox sh
# vintner recovery init: shell, read-only root mount, logs (WP-006 phase 1).
# Needs nothing from the installed system (architecture §4 "Recovery", R06).
/bin/busybox --install -s /bin
export PATH=/usr/sbin:/bin
# No udev here: device-mapper users create their own nodes.
export DM_DISABLE_UDEV=1
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs run /run
[ -d /sys/firmware/efi/efivars ] && mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null

# The kernel autoloads (crypto algorithms, aliases) through this path; busybox has no /sbin.
echo /bin/modprobe > /proc/sys/kernel/modprobe
while read -r m; do modprobe -q "$m" 2>/dev/null; done < /etc/vintner/modules
# Give storage drivers up to 10 s to register block devices.
i=0
while [ $i -lt 20 ] && ! grep -q ' [hsv]d[a-z][0-9]*$\| nvme\| mmcblk' /proc/partitions; do sleep 0.5; i=$((i + 1)); done
sleep 1

arg() { sed -n "s/.*vintner\.$1=\([^ ]*\).*/\1/p" /proc/cmdline; }
echo "vintner recovery $(cat /etc/vintner/version)"

# ask PROMPT: prints the first line typed on the screen (tty1) or on ttyS0,
# without echo. /dev/console reads only from the last console= device.
ask() {
	mkfifo /run/answer
	pids=
	for t in tty1 ttyS0; do
		[ -c /dev/$t ] || continue
		(printf '%s' "$1" >/dev/$t; stty -echo </dev/$t; read -r a </dev/$t; stty echo </dev/$t
			echo >/dev/$t; echo "$a" >/run/answer) 2>/dev/null &
		pids="$pids $!"
	done
	read -r a </run/answer
	# shellcheck disable=SC2086 # one PID per word
	kill $pids 2>/dev/null
	rm -f /run/answer
	echo "$a"
}

# md arrays and LVM volumes come up read-only, so the root and every layer
# under it stay byte-identical.
activate() {
	mdadm --assemble --scan --readonly >/dev/null 2>&1
	vgs=$(lvm vgs --noheadings -o vg_name 2>/dev/null | awk '{printf "%s\"%s\"", (NR > 1 ? "," : ""), $1}')
	[ -n "$vgs" ] && lvm vgchange -ay --sysinit --config "activation { read_only_volume_list = [ $vgs ] }" >/dev/null 2>&1
}
find_root() { case $spec in /dev/*) [ -b "$spec" ] && echo "$spec" ;; *) findfs "$spec" 2>/dev/null ;; esac; }

# Root: vintner.root=UUID=<fs uuid> (the manifest's root.uuid) or a /dev path,
# on a plain partition, md, LVM or LUKS. A LUKS passphrase is asked for only
# when the root is not found without it; an empty answer skips the device.
root=absent ro=no
spec=$(arg root)
if [ -n "$spec" ]; then
	root=failed
	activate
	dev=$(find_root)
	if [ -z "$dev" ]; then
		n=0
		# shellcheck disable=SC2013 # device names have no spaces
		for d in $(awk 'NR > 2 {print "/dev/" $4}' /proc/partitions); do
			cryptsetup isLuks "$d" 2>/dev/null || continue
			n=$((n + 1))
			pw=$(ask "Passphrase for $d (empty to skip): ")
			[ -n "$pw" ] && printf '%s' "$pw" | cryptsetup open --readonly --key-file=- "$d" "luks$n"
		done
		activate
		dev=$(find_root)
	fi
	mkdir -p /mnt/root
	# noload: never replay an ext4 journal, so the root stays byte-identical.
	if [ -n "$dev" ] && { mount -t ext4 -o ro,noload "$dev" /mnt/root 2>/dev/null || mount -o ro "$dev" /mnt/root; }; then
		root=mounted
		grep -q ' /mnt/root [^ ]* ro[, ]' /proc/mounts && ro=yes
	fi
fi

# Logs to /run, and to boot storage when found: the vfat partition holding /vintner.
L=/run/vintner/logs/$(date +%Y%m%dT%H%M%S)
mkdir -p "$L"
dmesg > "$L/dmesg.txt"
cat /proc/partitions > "$L/partitions.txt"
cat /proc/mounts > "$L/mounts.txt"
echo "root=$root ro=$ro spec=$spec" > "$L/root.txt"
logs=$L
mkdir -p /mnt/bs
for p in /sys/class/block/*/partition; do
	dev=/dev/$(basename "$(dirname "$p")")
	mount -t vfat -o ro "$dev" /mnt/bs 2>/dev/null || continue
	if [ -d /mnt/bs/vintner ] && mount -o remount,rw /mnt/bs; then
		d=/mnt/bs/vintner/recovery-logs/${L##*/}
		mkdir -p "$d" && cp "$L"/* "$d"/ && sync && logs=$dev:/vintner/recovery-logs/${L##*/}
	fi
	umount /mnt/bs
done

if [ "$(arg recovery_test)" = 1 ]; then
	echo "VINTNER-RECOVERY-TEST root=$root ro=$ro logs=$logs" > /dev/ttyS0
	poweroff -f
fi

echo "root: $root (read-only: $ro)  logs: $logs"
# One shell on the screen and one on ttyS0, each respawned.
for t in tty1 ttyS0; do
	# setsid -c takes stdin as the controlling tty; cttyhack would pick the last console.
	[ -c /dev/$t ] && (while :; do setsid -c sh </dev/$t >/dev/$t 2>&1; done) &
done
while :; do sleep 3600; done
